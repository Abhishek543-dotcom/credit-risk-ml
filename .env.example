# Environment Configuration for Credit Risk ML API

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Model Configuration
MODEL_PATH=models/production_model.pkl
SCALER_PATH=models/scaler.pkl
CONFIG_PATH=config.yaml

# Prediction Threshold
PREDICTION_THRESHOLD=0.5

# Monitoring Configuration
ENABLE_MONITORING=true
MONITORING_LOG_DIR=logs
MONITORING_RETENTION_DAYS=30

# Retraining Configuration
ENABLE_AUTO_RETRAIN=false
RETRAIN_SCHEDULE_CRON="0 2 * * 0"  # Every Sunday at 2 AM
RETRAIN_MIN_IMPROVEMENT=0.01

# MLflow Configuration (Optional)
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=credit-risk-production

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database (Optional - for production logging)
# DATABASE_URL=postgresql://user:password@localhost:5432/credit_risk

# Security (Optional)
# API_KEY=your-secret-api-key
# ENABLE_API_KEY_AUTH=false

# Performance
MAX_BATCH_SIZE=1000
REQUEST_TIMEOUT=30
